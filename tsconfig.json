{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": [".astro/types.d.ts", "src", "components", "lib", "api", "netlify"],
  "exclude": ["node_modules", "dist", "design"]
}
