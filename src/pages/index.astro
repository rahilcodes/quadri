---
// The whole site is this one page. Every component below is rendered to HTML at
// build time; the only JavaScript sent to the browser is src/scripts/site.ts.
import { getImage } from 'astro:assets';
import About from '@/components/About';
import Contact from '@/components/Contact';
import Disclaimer from '@/components/Disclaimer';
import FactStrip from '@/components/FactStrip';
import Footer from '@/components/Footer';
import Hero from '@/components/Hero';
import HowWeWork from '@/components/HowWeWork';
import JsonLd from '@/components/JsonLd';
import Nav from '@/components/Nav';
import type { PictureSource } from '@/components/Picture';
import Practice from '@/components/Practice';
import StickyBar from '@/components/StickyBar';
import { site, siteUrl } from '@/lib/site';
import heroImg from '@/images/hero_img.png';
import aboutImg from '@/images/about_img.png';
import type { ImageMetadata } from 'astro';
import '@/styles/global.css';

/** AVIF and WebP with a web fallback, at each width the layout can ask for. */
async function picture(imageFile: ImageMetadata, widths: number[], fallbackWidth: number): Promise<PictureSource> {
  const usable = widths.filter((width) => width <= imageFile.width);
  const make = (format: 'avif' | 'webp' | 'png', quality: number) =>
    getImage({ src: imageFile, format, quality, widths: usable, width: fallbackWidth });
  const [avif, webp, png] = await Promise.all([make('avif', 60), make('webp', 75), make('png', 80)]);
  return {
    src: png.src,
    srcSet: png.srcSet.attribute,
    formats: [
      { type: 'image/avif', srcSet: avif.srcSet.attribute },
      { type: 'image/webp', srcSet: webp.srcSet.attribute },
    ],
    width: imageFile.width,
    height: imageFile.height,
  };
}

// Hero: up to 480 px wide on desktop, full width on phones, at 1x to 3x.
const heroPortrait = await picture(heroImg, [320, 390, 480, 640, 780, 960], 480);
// About: fixed 160 px, at 1x to 3x.
const aboutPortrait = await picture(aboutImg, [160, 320, 480], 160);

const canonical = `${siteUrl}/`;
const ogImage = `${siteUrl}/og.png`;
const heroSizes = '(min-width: 1440px) 480px, (min-width: 1024px) 34vw, (min-width: 640px) 420px, 100vw';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.meta.title}</title>
    <meta name="description" content={site.meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0e0f12" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.meta.title} />
    <meta property="og:description" content={site.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${site.lockup}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.meta.title} />
    <meta name="twitter:description" content={site.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- The hero portrait is the largest paint: fetch it first, in the best format the browser takes. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroPortrait.formats[0].srcSet}
      imagesizes={heroSizes}
      fetchpriority="high"
    />
    <!-- The two hero faces. Everything else loads on demand with font-display: swap. -->
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Motion styles only hide content once we know scripts run. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <JsonLd />
  </head>
  <body>
    <a class="skip-link button on-ivory" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <Hero portrait={heroPortrait} />
      <FactStrip />
      <Practice />
      <About portrait={aboutPortrait} />
      <HowWeWork />
      <Contact />
    </main>
    <Footer />
    <StickyBar />
    <Disclaimer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
