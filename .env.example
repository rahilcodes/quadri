# Copy to .env.local for development; set the same names in Vercel or Netlify for production.

# Canonical origin, no trailing slash. Overrides "url" in content/site.json.
NEXT_PUBLIC_SITE_URL=https://quadriadvocates.in

# Contact form (Resend). The sender must be on a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
